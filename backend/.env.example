DATABASE_URL=postgresql://usuario:password@localhost:5432/sistema_celulares
JWT_SECRET=cambiar-esto-por-un-secreto-largo
PORT=4000

# Mercado Pago (cobro con tarjeta/QR y detección automática de pago)
# Access Token de producción o de prueba, desde https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=
# Clave secreta del webhook (misma pantalla del panel de developers, sección "Webhooks")
MP_WEBHOOK_SECRET=
# URL pública donde corre este backend, para que Mercado Pago pueda avisarle al webhook.
# En local hace falta un túnel (ngrok, cloudflared, etc), ej: https://abc123.ngrok-free.app
APP_BASE_URL=http://localhost:4000
